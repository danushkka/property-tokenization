{
  "name": "property-tokenization-client",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript read scripts (viem) for the property tokenization contracts",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "read:token": "tsx --env-file=../.env src/readers/tokenData.ts",
    "read:compliance": "tsx --env-file=../.env src/readers/compliance.ts",
    "read:purchase": "tsx --env-file=../.env src/readers/purchaseFlow.ts",
    "read:dividends": "tsx --env-file=../.env src/readers/dividends.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danushkka/property-tokenization.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/danushkka/property-tokenization/issues"
  },
  "homepage": "https://github.com/danushkka/property-tokenization#readme",
  "dependencies": {
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}